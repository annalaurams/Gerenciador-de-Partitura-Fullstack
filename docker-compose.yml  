version: "3.9"

services:

  db:
    image: postgres:15
    container_name: clave-db
    restart: always
    environment:
      POSTGRES_DB: gerenciador_partituras
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
    ports:
      - "5432:5432"
    volumes:
      - pgdata:/var/lib/postgresql/data

  backend:
    build: ./back
    container_name: clave-backend
    restart: always
    depends_on:
      - db
    ports:
      - "3333:3333"
    environment:
      DATABASE_URL: postgresql://postgres:postgres@db:5432/gerenciador_partituras
      JWT_SECRET: supersecret
      PORT: 3333
    volumes:
      - ./back/uploads:/app/uploads

  frontend:
    build: ./front/my-app
    container_name: clave-frontend
    restart: always
    depends_on:
      - backend
    ports:
      - "3000:80"

volumes:
  pgdata:
